# Copy to secrets.yaml (git-ignored) and fill in.
# Generate an API key with: openssl rand -base64 32
wifi_ssid: "your-wifi"
wifi_password: "your-wifi-password"
fallback_ap_password: "change-me-too"
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY="
ota_password: "change-me"
# Only needed if you enable web_server auth.
web_username: "admin"
web_password: "change-me"
